# Product vs test behavior (server/config.ts). Not the lobby's "test mode".
# true: development, testing and rehearsals: copies of the panel's audio and
#   avatar videos are kept under logs/.
# false or unset: the real product and the live presentation.
TEST=true

# Backup LLMs (server/config.ts). true: before each interview the server tries the
#   providers in LLM_ORDER below and uses the first that answers, so the interview
#   still runs when DeepSeek is down. false or unset: DeepSeek only, no fallback.
BACKUP=false

# Boson AI key (Higgs Realtime + Higgs TTS 3 + Higgs Avatar). Server-side only.
BOSON_API_KEY=

# The two TTS panelists speak as Higgs Avatar talking heads on their voice's catalog
# portrait (about $0.07 per minute of video); a preset voice has no portrait and stays
# voice only. A seat whose video fails turns its camera off and speaks as audio.
# With TEST=true every avatar video is also saved under logs/avatar/.
# AVATAR=true

# DeepSeek key for the Orchestrator (OpenAI-compatible chat API). Turn detection
# also uses it: deepseek-flash judges whether the candidate finished answering.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Deep mode only (no round uses it now; all three answer without thinking):
# low | high | max; DeepSeek defaults to high.
# DEEPSEEK_REASONING_EFFORT=high

# Backup LLMs for the Orchestrator (BACKUP=true). Each time an interview starts, the
# server tries the providers in LLM_ORDER with a tiny call and uses the first that
# works for the whole interview. A provider without a key is skipped.
# LLM_ORDER=deepseek,openai,claude,gemini
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Backup for turn detection: true turns it off, and the candidate ends each
# answer with a "Done answering" button. Read by the browser (Vite) at startup.
# VITE_MANUAL_TURNS=true

# Whisper transcribes the candidate's answers (Higgs STT is the backup): whisper.cpp's
# whisper-server, started by `npm run dev` on port 8178 (see README). Change only if it runs elsewhere.
# WHISPER_URL=http://127.0.0.1:8178

# Local PostgreSQL. Create it once with: createdb hotseat
DATABASE_URL=postgres://localhost:5432/hotseat

# PORT=3100
